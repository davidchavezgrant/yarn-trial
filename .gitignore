node_modules/
out/
# ...except the benchmark RESULTS. out/ is ignored because it holds build output, recordings
# and frames — regenerable bulk. out/bench is the opposite: manifests, per-arm archived
# appmaps and the measured token/cost figures, none of which can be recreated without
# re-running the passes that produced them (~$45 for phase 1 alone, hours of fleet time).
# 472K as of 2026-08-01. Recordings and step frames stay ignored — those live under
# out/recording and out/runs.
!out/bench/
!out/bench/**
.env
.playwright-mcp/
.DS_Store
CLAUDE.md
tools/winrec
*.bak

# Swift sidecar build artifacts
native/axdom
native/liveview
native/default-browser
tmp/
dist-electron

# Fleet credentials: the private SSH key for every Mac in hosts.json, plus the team
# OpenRouter key. Distributed with the app, never through git.
team-credentials.json
*.pem
id_ed25519*

# Holds a live OpenRouter key today. Already covered by David's personal ~/.config/git/ignore,
# which is exactly the problem: a teammate who clones this repo does not have that file, and
# the protection would silently not exist for them.
.claude/settings.local.json
.env.*

# Full checkouts made by agent worktrees. Several hundred MB, and each one carries its own
# copy of everything above — including files this list exists to keep out.
.claude/worktrees/
# Python bytecode from the render/fit scripts.
__pycache__/

# Source corpora for the cursor motion fit. The render path reads only the fitted outputs
# (data/motion-constants.json, data/motion-segments.json); these are needed solely to re-run
# scripts/fit-motion.py. 185MB, kept out of history deliberately.
data/cursor-keyboard-dataset-2026-07-30/
data/cursor-smoothed-dataset/

# Backups the claude-use-subscription script writes beside settings.local.json —
# same secret-bearing content as the ignored original, so they must never track.
.claude/settings.local.json.bak-*
