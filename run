#!/usr/bin/env bash
# One entry point for the demo agent. Everything else in this repo is a script you have to
# remember the shape of; this is the thing you can hand to someone.
#
# The command guide lives in usage() below — `./run help` (or -h/--help) prints it.
#
# Teammates run almost none of it: drop team-credentials.json beside this script (or in
# ~/.yarn-runner/, or ship it inside the .app) and the first ./run installs the fleet key and
# the model key for them. Nothing to generate, nothing to send anyone.
#
# Auth: reads .env / ../yarn/.env / ~/.yarn-runner/env if present, else expects
# OPENROUTER_API_KEY or ANTHROPIC_API_KEY already exported.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")"

runner_dir=${YARN_RUNNER_DIR:-$HOME/.yarn-runner}

# Before the bundle check below, which shells out to tsx.
[[ -d node_modules ]] || { echo "installing dependencies…"; npm install --silent; }

# A teammate's first ./run IS their enrollment. If the shipped team bundle is here and this
# machine has no fleet key yet, install it now — otherwise the first remote command fails with
# a missing-identity error that reads like a bug rather than a setup step. One-time: the guard
# is the key's existence, so this costs nothing on every subsequent run.
if [[ ! -f $runner_dir/id_ed25519 ]]; then
	for bundle in "${YARN_TEAM_CREDENTIALS:-}" team-credentials.json "$runner_dir/team-credentials.json"; do
		if [[ -n $bundle && -f $bundle ]]; then
			# Braces are load-bearing: the ellipsis is multibyte UTF-8 and bash reads those
			# bytes as part of the identifier, so "$bundle…" is an unbound variable under set -u.
			echo "installing team credentials from ${bundle}…"
			npx tsx src/remote/control/enroll.ts || true
			break
		fi
	done
fi

# Keys live outside the repo (../yarn/.env is where David keeps the OpenRouter one). The
# runner dir comes last and is the teammate case: the bundle wrote the model key there, and
# nothing else on their machine has one.
# `set -a` exports everything sourced so child processes inherit it.
for env_file in .env ../yarn/.env "$runner_dir/env"; do
	if [[ -f $env_file ]]; then
		set -a
		# shellcheck disable=SC1090
		source "$env_file"
		set +a
		break
	fi
done

have_key() { [[ -n ${OPENROUTER_API_KEY:-} || -n ${ANTHROPIC_API_KEY:-} ]]; }

die() {
	printf '\033[31m%s\033[0m\n' "$1" >&2
	exit 1
}

usage() {
	# Bold only when a human is looking; pipes and logs get plain text. No backticks or
	# stray $ in the heredoc — it is unquoted so ${b}/${n} expand.
	local b='' n=''
	[[ -t 1 ]] && b=$'\033[1m' n=$'\033[0m'
	cat <<EOF
${b}./run${n} — one entry point for the demo agent

${b}run${n}
  ./run                                  packaged app (Electron) — the deployment target
  ./run "<task>" ["App"] [--record]      headless task run (default app: Yarn; flags pass through)
  ./run "<task>" --url <https://site>    ...against a website instead of an installed app

${b}ground & replay${n}
  explore "App" | --url <https://site>   grounding pass -> docs/appmaps/
  recipe compile <stamp>                 freeze a successful run into a replayable recipe
  recipe replay <file|stamp>             replay it — zero model calls unless a step breaks
  appmaps [--sync] [--app <name>]        which Mac holds which grounding; --sync converges the fleet

${b}fleet${n}
  hosts                                  show the fleet and which Macs are free
  dispatch auto "<task>" "App"           run on a free Mac, follow it, pull artifacts back
  dispatch <mac> explore "App"           grounding pass on a named Mac
  dispatch <mac> follow|pull <jobId>     re-attach to a run in flight / fetch a finished run's artifacts
  provision [--doctor|--restart]         push this checkout to the Macs / grade them / bounce runners
  install "App" <https://site|path>      put a target app on the Macs (--check: is it installed, where)
  uninstall <mac> "App"                  remove an app from that Mac, plus all parked profiles for it

${b}sign-in & sessions${n}
  signin <mac> ["App"]                   screen-share to a Mac to sign an app in by hand
  liveview [<mac>] ["App"]               window-scoped sign-in: drive just one window in a browser
  browser-login <https://site>           one-time local sign-in, so later web runs are logged in
  signout <mac> "App"                    sign YOU out of an app on that Mac (deletes your data there)
  browser-wipe [<mac>|all] [--go]        wipe Chrome profiles on the Macs (accounts, passwords)
  session-wipe [<mac>|all] [--go]        close every GUI app on the Macs, wipe all session data

${b}bench${n}
  bench plan                             print the benchmark matrix (no side effects)
  bench phase <1|2|3|4> --go             submit that phase to the fleet queue (without --go: preview)
  bench collect                          pull finished runs, compute metrics, rewrite the report
  bench judge                            re-grade landed runs with the offline judge (idempotent)
  dash [--port N] [--no-collect] [--web] live dashboard (Electron): fleet, matrix progress, charts
                                         as results land (auto-runs collect; --no-collect = pure
                                         reader; --web = headless server on localhost:4642)

${b}setup & health${n}
  doctor                                 check permissions, keys, deps before demoing
  enroll [--export [file]]               mint the fleet key, pin host keys, install it on each Mac
                                         (--export bundles it + the model key for teammates)

Auth: reads .env / ../yarn/.env / ~/.yarn-runner/env if present, else expects
OPENROUTER_API_KEY or ANTHROPIC_API_KEY already exported.
EOF
}

# A run started while another is in flight kills BOTH: the second driver session shuts down
# the shared daemon (LIMITATIONS §6). Cheaper to refuse here than to lose a 20-action run.
assert_no_run_in_flight() {
	if pgrep -f "tsx src/core/(agent|explore|recipe-cli)\.ts" >/dev/null 2>&1; then
		die "a run is already in flight — driver sessions are not concurrent-safe (LIMITATIONS §6).
Wait for it, or: pkill -f 'tsx src/'"
	fi
}

cmd=${1:-app}

case $cmd in
app | "")
	have_key || die "no API key: export OPENROUTER_API_KEY or ANTHROPIC_API_KEY (or put it in .env)"
	# Compile only when a source file is newer than the built entry point — a demo should
	# not sit through tsc every launch.
	if [[ ! -f dist-electron/electron/main.js ]] ||
		[[ -n $(find src electron -name '*.ts' -newer dist-electron/electron/main.js -print -quit 2>/dev/null) ]]; then
		echo "building…"
		npx tsc -p tsconfig.electron.json
	fi
	exec npx electron dist-electron/electron/main.js
	;;

explore)
	have_key || die "no API key: export OPENROUTER_API_KEY or ANTHROPIC_API_KEY (or put it in .env)"
	[[ $# -ge 2 ]] || die 'usage: ./run explore "App Name" | ./run explore --url https://example.com'
	assert_no_run_in_flight
	shift
	exec npx tsx src/core/explore.ts "$@"
	;;

recipe)
	# compile needs no key (pure file transform); replay may need one for rescue + teardown,
	# but --no-rescue with CLEANUP=off is fully offline, so the key check stays soft here.
	[[ $# -ge 3 || ${2:-} == compile ]] || die 'usage: ./run recipe compile <stamp> | ./run recipe replay <file|stamp> [--url <https://…>] [--no-rescue]'
	# Replays drive the same single driver session as agent/explore (LIMITATIONS §6).
	assert_no_run_in_flight
	shift
	exec npx tsx src/core/recipe-cli.ts "$@"
	;;

enroll)
	# Interactive by necessity: installing a public key requires already being allowed in,
	# and the only credential that proves that is the admin password. No key needed here —
	# this touches the fleet, not the model.
	# "$@" is not decoration: without it --export never reaches enroll.ts, which reads it from
	# process.argv, and the export silently does a plain enroll instead.
	shift
	exec npx tsx src/remote/control/enroll.ts "$@"
	;;

hosts)
	exec npx tsx src/remote/control/fleet.ts
	;;

provision)
	# Pushes this checkout to each Mac and installs the LaunchAgent that holds the runner
	# socket. Must follow enroll: it reuses the pinned known_hosts and the fleet identity.
	shift
	exec npx tsx src/remote/control/provision.ts "$@"
	;;

dispatch)
	# No assert_no_run_in_flight: that guard is about THIS machine's driver session, and the
	# remote lease is the mutex for the target. No have_key either — the model key is read on
	# the far side from its own ~/.yarn-runner/env, so requiring one here is a false refusal.
	shift
	exec npx tsx src/remote/control/dispatch.ts "$@"
	;;

install)
	# Puts a target app on the Macs before a run needs it. Presence is decided by a fresh probe
	# of the four Applications directories, never by the installer's exit code — a dmg can mount
	# and copy cleanly and still leave nothing named what the run will try to open. Must follow
	# enroll: it reuses the pinned known_hosts and the fleet identity.
	shift
	exec npx tsx src/remote/control/install.ts "$@"
	;;

signin)
	# The manual half of remote auth. An app behind SSO cannot be signed in by the agent —
	# credentials would land in observations, in the model's context and in the recording — so
	# a human does it once per app per Mac over screen sharing and the app keeps the session.
	# No have_key: this never talks to a model.
	shift
	exec npx tsx src/remote/control/signin.ts "$@"
	;;

signout | uninstall)
	# The destructive half of remote app/auth management. Both go through the runner verbs
	# (authclear/appdelete), which refuse while a run holds the lease and derive every path
	# they delete on the far side — nothing variable crosses as argv text. No have_key: no
	# model involved. The verb itself is passed through, so no shift.
	exec npx tsx src/remote/control/manage.ts "$@"
	;;

appmaps)
	# Which Mac holds which grounding; --sync converges the fleet (newest capturedAt wins,
	# .md and .json travel together). Runs automatically around dispatch and after a
	# grounding pass — this is the manual handle. No have_key: no model. No
	# assert_no_run_in_flight: remote rsync only, never a local driver session.
	shift
	exec npx tsx src/remote/control/appmaps.ts "$@"
	;;

bench)
	# The benchmark orchestrator (src/bench/). Phase-gated: nothing dispatches without an
	# explicit --go, which orchestrate.ts itself enforces — this case only routes. No
	# assert_no_run_in_flight: bench submits to REMOTE queues and never starts a local driver
	# session. No have_key: `plan`/preview are offline, and dispatched runs read the model key
	# on the far side from their own ~/.yarn-runner/env.
	shift
	exec npx tsx src/bench/orchestrate.ts "$@"
	;;

dash)
	# Live view over the benchmark manifest + fleet (src/bench/dash.ts + electron/dash.ts).
	# Auto-runs the idempotent `bench collect` on a loop so results land while the fleet
	# drains; --no-collect makes it a pure reader. Electron window by default; --web serves
	# headless on http://localhost:4642 instead. No assert_no_run_in_flight: it reads
	# registries and pulls artifacts, never starts a driver session. No have_key: no model.
	shift
	if [[ " $* " == *" --web "* || ${1:-} == --web ]]; then
		exec npx tsx src/bench/dash.ts "$@"
	fi
	npx tsc -p tsconfig.electron.json
	exec npx electron dist-electron/electron/dash.js "$@"
	;;

browser-wipe)
	# Remove every Chrome profile on the fleet Macs: the signed-in accounts, the saved
	# passwords, the form history. Gated — without --go it previews and exits 2.
	#
	# Safe BECAUSE Chrome is quit first: a delete through a running, signed-in Chrome emits a
	# sync tombstone that removes the credential from that person's Google vault and every
	# device they own, while a delete with the browser closed is purely local. See the header
	# of src/remote/control/browser-wipe.ts.
	shift
	exec npx tsx src/remote/control/browser-wipe.ts "$@"
	;;

session-wipe)
	# Clear ALL session state on the fleet Macs: close every GUI app (SIGTERM, then SIGKILL —
	# Chrome must be provably dead before anything is deleted, or it writes the files back on
	# quit), then remove the default Chrome profiles, the cdp backend's persistent web-login
	# profiles, every operator's parked app profiles, and every installed app's live data
	# under ~/Library. The runner daemon survives. Gated — without --go it previews and
	# exits 2; a busy host is refused without --force. See src/remote/control/session-wipe.ts.
	shift
	exec npx tsx src/remote/control/session-wipe.ts "$@"
	;;

browser-login)
	# One-time, per machine, per site: bring up the cdp backend's persistent Chrome profile
	# on a URL so a human can sign in. The profile persists, so every later web run inherits
	# that session — which is the whole reason unattended grounding of a logged-in app is
	# possible. (Web runs live on the cdp backend since the dom backend was removed.)
	[[ $# -ge 2 ]] || die 'usage: ./run browser-login https://www.notion.so'
	assert_no_run_in_flight
	shift
	exec npx tsx src/backends/cdp-login.ts "$@"
	;;

liveview)
	# Window-scoped sign-in: the human drives ONLY the window being signed into, in their own
	# browser, over an SSH tunnel. The counterpart to `signin` (full-desktop screen share).
	# Capture needs native/liveview built (npm run build:native). No have_key: no model involved.
	#
	# Backstop against a login stream capturing over a demo recording. The CLI itself also checks
	# the runner lease (loginBlockedByRun) — belt and braces, since a direct dev run may not hold a
	# lease at all, and pgrep catches that case the lease cannot see.
	assert_no_run_in_flight
	shift
	exec npx tsx src/remote/liveview-cli.ts "$@"
	;;

doctor)
	printf '\033[1mchecking demo prerequisites\033[0m\n'
	ok() { printf '  \033[32m✓\033[0m %s\n' "$1"; }
	no() { printf '  \033[31m✗\033[0m %s\n' "$1"; }

	if have_key; then ok "API key present"; else no "no OPENROUTER_API_KEY / ANTHROPIC_API_KEY"; fi
	# Fingerprint only, never the key: doctor output is the thing people paste into a message.
	if [[ -f $runner_dir/id_ed25519 ]]; then
		ok "fleet ssh identity ($(ssh-keygen -lf "$runner_dir/id_ed25519.pub" 2>/dev/null | awk '{print $2}' || echo 'fingerprint unavailable'))"
	else
		no "no fleet identity — drop team-credentials.json here, or run: ./run enroll"
	fi
	[[ -d node_modules ]] && ok "node_modules installed" || no "run: npm install"
	command -v ffmpeg >/dev/null && ok "ffmpeg (video assembly)" || no "ffmpeg missing — --record cannot assemble an mp4"
	python3 -c 'import PIL' 2>/dev/null && ok "python3 + PIL (frame QC, pixel deltas)" || no "python3/PIL missing — pixel-delta verification degrades"
	[[ -x native/axdom ]] && ok "axdom sidecar built (DOM enrichment)" || no "axdom not built — run: npm run build:native (optional)"

	driver=/Applications/CuaDriver.app/Contents/MacOS/cua-driver
	if [[ -x $driver ]]; then
		ok "cua-driver installed"
		# Read-only; never prompts. Reports `unknown` when no daemon is running, which is
		# itself worth showing rather than hiding behind a bare pass/fail.
		"$driver" permissions status 2>/dev/null | sed 's/^/    /' || true
	else
		no "cua-driver not found at $driver"
	fi

	shopt -s nullglob
	maps=(docs/appmaps/*.md)
	if ((${#maps[@]})); then
		ok "grounded apps: $(basename -s .md "${maps[@]}" | tr '\n' ' ')"
	else
		no "no appmaps — run: ./run explore \"App Name\""
	fi
	;;

-h | --help | help)
	usage
	;;

*)
	# Anything else is a task string: ./run "show me how to X" ["App"] [--record ...].
	# Task prompts are sentences; a lone word with no spaces is a mistyped subcommand, and
	# letting it through would start a model-billed agent run with that word as the task.
	if [[ $cmd != *[[:space:]]* ]]; then
		printf "./run: '%s' is not a command, and a task prompt is a full sentence.\n" "$cmd" >&2
		printf 'see: ./run help\n' >&2
		exit 2
	fi
	have_key || die "no API key: export OPENROUTER_API_KEY or ANTHROPIC_API_KEY (or put it in .env)"
	assert_no_run_in_flight
	exec npx tsx src/core/agent.ts "$@"
	;;
esac
