{
  "name": "selfdriving-demo",
  "version": "0.1.0",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "probe": "tsx src/probes/probe.ts",
    "typecheck": "tsc",
    "test": "tsx --test tests/*.test.ts",
    "agent": "tsx src/core/agent.ts",
    "explore": "tsx src/core/explore.ts",
    "cleanup": "tsx src/core/cleanup.ts",
    "recipe": "tsx src/core/recipe-cli.ts",
    "home": "tsx src/core/home.ts",
    "humanize": "tsx src/cursor/humanize.ts",
    "build:native": "swiftc -O native/axdom.swift -o native/axdom && swiftc -O native/liveview.swift -o native/liveview",
    "app": "tsc -p tsconfig.electron.json && electron dist-electron/electron/main.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Self-driving demo agent: NL task -> verified UI actions on a Mac app",
  "type": "module",
  "dependencies": {
    "@anthropic-ai/sdk": "0.115.0",
    "@trycua/cua-driver": "0.12.5",
    "playwright-core": "^1.62.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "electron": "^33.4.11",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
